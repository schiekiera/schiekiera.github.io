{% comment %}
  Experience / Education rows for the CV, styled like the Teaching and Talks
  rows: date on the left, title plus a muted institution line on the right.
  Thesis / advisor lines (`description` or `items`) sit underneath, quietly.
{% endcomment %}
<ul class="activity-list">
  {% for content in entry.contents %}
    <li class="activity-row">
      <span class="activity-row__date">{{ content.year }}</span>
      <span class="activity-row__main">
        <span class="activity-row__venue">{{ content.title }}</span>
        {%- if content.institution or content.department or content.location %}
          <span class="activity-row__sub">
            {%- if content.institution_url -%}
              <a href="{{ content.institution_url }}" target="_blank" rel="noopener noreferrer">{{ content.institution }}</a>
            {%- else -%}
              {{ content.institution }}
            {%- endif -%}
            {%- if content.department %} · {{ content.department }}{% endif -%}
            {%- if content.location %}, {{ content.location }}{% endif -%}
          </span>
        {%- endif %}
        {%- assign details = content.description | default: content.items %}
        {%- for item in details %}
          <span class="activity-row__detail">{{ item.title | default: item }}</span>
        {%- endfor %}
      </span>
    </li>
  {% endfor %}
</ul>
