---
layout: default
---
<!-- about.html -->
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid path = profile_image_path class = profile_image_class sizes = sizes alt = page.profile.image
            width = 1400 height = 1400 loading = "eager" decoding = "async" fetchpriority = "high" cache_bust = true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
        <a class="view-all" href="{{ '/news/' | relative_url }}">view all &rarr;</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Selected papers: a toggle switches between the highlighted and all publications -->
    {% if page.selected_papers %}
      <h2 class="section-head">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit"
          ><span id="home-pubs-word">highlighted</span> publications</a
        >
        <a class="view-all" href="{{ '/publications/' | relative_url }}">view all &rarr;</a>
        <span class="seg-toggle" role="group" aria-label="Show publications" data-target="#home-pubs" data-label-target="#home-pubs-word">
          <span class="seg-toggle__thumb" aria-hidden="true"></span>
          <button type="button" class="seg-toggle__opt is-active" data-value="highlighted" data-label="highlighted" aria-pressed="true">Highlighted</button>
          <button type="button" class="seg-toggle__opt" data-value="all" data-label="all" aria-pressed="false">All</button>
        </span>
      </h2>
      <div id="home-pubs" class="home-pubs" data-view="highlighted">
        {% include selected_papers.liquid %}
      </div>
    {% endif %}

    <!-- Latest posts: a toggle switches between the recent and all posts -->
    {% if page.latest_posts %}
      {% assign home_posts_limit = site.latest_posts.limit | default: 3 %}
      <h2 class="section-head">
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit"><span id="home-posts-word">recent</span> posts</a>
        <a class="view-all" href="{{ '/blog/' | relative_url }}">view all &rarr;</a>
        {% if site.posts.size > home_posts_limit %}
          <span class="seg-toggle" role="group" aria-label="Show posts" data-target="#home-posts" data-label-target="#home-posts-word">
            <span class="seg-toggle__thumb" aria-hidden="true"></span>
            <button type="button" class="seg-toggle__opt is-active" data-value="recent" data-label="recent" aria-pressed="true">Recent</button>
            <button type="button" class="seg-toggle__opt" data-value="all" data-label="all" aria-pressed="false">All</button>
          </span>
        {% endif %}
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
